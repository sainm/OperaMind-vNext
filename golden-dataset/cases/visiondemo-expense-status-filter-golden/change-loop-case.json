  "edit": {
    "forbidden_paths": ["VisionDemo/pom.xml"],
    "replacements": [
      {
        "path": "VisionDemo/src/main/java/com/visiondemo/service/ExpenseService.java",
        "before": "    public Page<Expense> search(String status, int page, int size) {\n        return expenseRepository.search(status, PageRequest.of(page, size));\n    }\n",
        "after": "    public Page<Expense> search(String status, int page, int size) {\n        String normalizedStatus = status == null || status.isBlank() ? null : status;\n        return expenseRepository.search(normalizedStatus, PageRequest.of(page, size));\n    }\n"
      }
    ],
