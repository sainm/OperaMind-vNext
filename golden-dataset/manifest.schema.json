{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/golden-dataset/manifest.schema.json",
  "title": "GoldenDatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "dataset_version",
    "dataset_stage",
    "status",
    "projects",
    "cases"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_stage": {"enum": ["silver", "golden_candidate", "golden"]},
    "status": {"enum": ["needs_review", "approved", "frozen"]},
    "reviewers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "candidate_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_type", "author", "human_review_required"],
      "properties": {
        "author_type": {"const": "ai_assisted"},
        "author": {"type": "string", "minLength": 1},
        "human_review_required": {"const": true}
      }
    },
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"},
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"},
      "minItems": 1
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "repository_url", "repository_commit", "scan_roots"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "minLength": 1},
        "repository_subdirectory": {"type": "string", "minLength": 1},
        "scan_roots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "project_id",
        "source_manifest",
        "expected_changes",
        "expected_rag_context",
        "expected_code_scope",
        "expected_ui_scenarios",
        "review"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "source_manifest": {"type": "string", "minLength": 1},
        "expected_changes": {"type": "string", "minLength": 1},
        "expected_rag_context": {"type": "string", "minLength": 1},
        "expected_code_scope": {"type": "string", "minLength": 1},
        "expected_ui_scenarios": {"type": "string", "minLength": 1},
        "test_data_plan": {"type": "string", "minLength": 1},
        "review": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"dataset_stage": {"const": "golden_candidate"}},
        "required": ["dataset_stage"]
      },
      "then": {
        "required": ["candidate_provenance"],
        "not": {"required": ["reviewers"]},
        "properties": {
          "status": {"const": "needs_review"},
          "projects": {"minItems": 1},
          "cases": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"dataset_stage": {"const": "golden"}},
        "required": ["dataset_stage"]
      },
      "then": {
        "required": ["reviewers"],
        "not": {"required": ["candidate_provenance"]},
        "properties": {
          "status": {"const": "frozen"},
          "projects": {"minItems": 1},
          "cases": {"minItems": 1, "maxItems": 5}
        }
      }
    }
  ]
}
