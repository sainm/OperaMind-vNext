{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/golden-dataset/change-loop-batch-report.schema.json",
  "title": "ChangeLoopBatchReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "input_mode", "operation", "status", "case_count", "summary", "results"],
  "properties": {
    "schema_version": {"const": "v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "input_mode": {"enum": ["documents", "natural_language"]},
    "operation": {"enum": ["plan", "execute"]},
    "status": {"enum": ["passed", "failed"]},
    "case_count": {"type": "integer", "minimum": 0},
    "summary": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "failure_class", "message", "output", "artifact_count", "closure_result"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "passed", "needs_confirmation", "reanalysis_required", "environment_failed", "business_failed"]},
          "failure_class": {"type": ["string", "null"], "enum": [null, "needs_confirmation", "reanalysis_required", "environment_failed", "business_failed"]},
          "message": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "artifact_count": {"type": "integer", "minimum": 0},
          "closure_result": {"type": ["string", "null"]}
        }
      }
    }
  }
}
