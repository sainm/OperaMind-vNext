# Copy this file to .env. The real .env is local-only and ignored by Git.

# Stable macOS/Homebrew development database. Windows should replace this with a
# password-authenticated TCP URL such as:
# postgresql://operamind:CHANGE_ME@127.0.0.1:5432/operamind_vnext
OPERAMIND_DATABASE_URL=postgresql:///operamind_vnext?host=/private/tmp&port=5432

# Keep one deterministic internal task active at a time during manual testing.
OPERAMIND_MAX_ACTIVE_TASKS_PER_RUN=1

# Local LM Studio embedding provider used by profiles/embedding-profile.example.json.
EMBED_API_URL=http://127.0.0.1:1234/v1
EMBED_API_KEY=lm-studio
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
OPERAMIND_EMBEDDING_LIVE_PROFILE=profiles/embedding-profile.example.json

# Bridge Token is generated by operamind-launcher in the per-user application
# directory and synchronized to VS Code SecretStorage by the extension. Do not add
# OPERAMIND_BRIDGE_TOKEN to this file.

# Optional: required only when a TestDataPlan contains HTTP/UI steps. This must be the
# target application's credential-free origin, not the OperaMind Web address.
# OPERAMIND_TEST_TARGET_BASE_URL=http://127.0.0.1:8080

# Test-only admin connection. Pytest creates and deletes a random migrated database;
# it never cleans or reuses OPERAMIND_DATABASE_URL.
# OPERAMIND_TEST_DATABASE_URL=postgresql://operamind:CHANGE_ME@127.0.0.1:5432/operamind_test
