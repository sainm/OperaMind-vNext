# Runtime database used by the future control plane.
OPERAMIND_DATABASE_URL=postgresql://operamind:CHANGE_ME@localhost:5432/operamind

# Seed/admin connection used to create a migrated random database for each pytest session.
# The role needs CREATEDB; the named database itself is never migrated or cleaned by pytest.
OPERAMIND_TEST_DATABASE_URL=postgresql://operamind:CHANGE_ME@localhost:5432/operamind_test
