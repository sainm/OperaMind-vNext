{
  "servers": {
    "operaMind": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/operamind-mcp",
      "args": ["--root", "${workspaceFolder}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "OPERAMIND_DATABASE_URL": "${input:operamind-database-url}"
      }
    }
  },
  "inputs": [
    {
      "id": "operamind-database-url",
      "type": "promptString",
      "description": "OperaMind PostgreSQL 接続 URL",
      "password": true
    }
  ]
}
