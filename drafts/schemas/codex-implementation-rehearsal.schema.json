{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/drafts/codex-implementation-rehearsal.schema.json",
  "title": "CodexImplementationRehearsal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "producer",
    "generated_at",
    "status",
    "bindings",
    "execution_policy",
    "changes",
    "findings",
    "validation_steps"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "proposal_id": {"$ref": "#/$defs/nonBlank"},
    "producer": {"const": "openai_codex"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready_for_copilot_review", "needs_reanalysis"]},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "project_id",
        "analysis_case_id",
        "edit_packet_id",
        "base_revision"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/nonBlank"},
        "project_id": {"$ref": "#/$defs/nonBlank"},
        "analysis_case_id": {"$ref": "#/$defs/nonBlank"},
        "edit_packet_id": {"$ref": "#/$defs/nonBlank"},
        "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "automatic_apply_allowed",
        "required_final_editor",
        "copilot_must_revalidate"
      ],
      "properties": {
        "executable": {"const": false},
        "automatic_apply_allowed": {"const": false},
        "required_final_editor": {"const": "github_copilot_vscode"},
        "copilot_must_revalidate": {"const": true}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "candidate_patch",
          "candidate_content",
          "rationale"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "operation": {"enum": ["modify", "add"]},
          "candidate_patch": {"type": ["string", "null"]},
          "candidate_content": {"type": ["string", "null"]},
          "rationale": {"$ref": "#/$defs/nonBlank"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonBlank"}
    },
    "validation_steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonBlank"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "needs_reanalysis"}}},
      "then": {
        "properties": {
          "changes": {"maxItems": 0},
          "findings": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "nonBlank": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
  }
}
