{
  "schema_version": "orchestration_worker_handlers_v1",
  "handlers": [
    {
      "action": "generate_orchestration",
      "command": [
        ".venv/bin/operamind-orchestration-generate-handler",
        "--root",
        "."
      ],
      "working_directory": ".",
      "timeout_seconds": 900,
      "environment_keys": [
        "OPERAMIND_DATABASE_URL"
      ],
      "max_output_bytes": 1000000
    }
  ]
}
