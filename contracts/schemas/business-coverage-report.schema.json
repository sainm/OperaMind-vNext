{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/business-coverage-report.schema.json",
  "title": "BusinessCoverageReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "coverage_report_id", "change_request_id", "test_plan_id", "acceptance_criteria_id", "project_id", "business_rule_count", "covered_rule_count", "coverage_percent", "items", "status"],
  "properties": {
    "artifact_type": {"const": "BusinessCoverageReport"},
    "schema_version": {"const": "v1"},
    "coverage_report_id": {"type": "string", "minLength": 1},
    "change_request_id": {"type": "string", "minLength": 1},
    "test_plan_id": {"type": "string", "minLength": 1},
    "acceptance_criteria_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "business_rule_count": {"type": "integer", "minimum": 1},
    "covered_rule_count": {"type": "integer", "minimum": 0},
    "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["business_rule_id", "test_case_refs", "criterion_refs", "status"],
        "properties": {
          "business_rule_id": {"type": "string", "minLength": 1},
          "test_case_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "criterion_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "verification_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_kind", "source_refs", "assertion"],
              "properties": {
                "source_kind": {"enum": ["ui_test", "code_test", "command_evidence", "canonical_evidence", "plan_evidence"]},
                "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
                "assertion": {"type": "string", "minLength": 1}
              }
            }
          },
          "status": {"enum": ["covered", "uncovered"]}
        }
      }
    },
    "status": {"enum": ["passed", "failed"]}
  }
}
