{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/context-package.schema.json",
  "title": "ContextPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "context_package_id",
    "analysis_case_id",
    "project_id",
    "document_snapshot_id",
    "ingestion_batch_id",
    "document_ingestion_result_event_id",
    "embedding_profile_ref",
    "search_index_build_id",
    "ranking_policy_version",
    "query_plan_version",
    "retrieval_policy",
    "structured_change_refs",
    "business_summary",
    "context_items",
    "retrieval_trace",
    "token_budget",
    "estimated_tokens"
  ],
  "properties": {
    "artifact_type": {"const": "ContextPackage"},
    "schema_version": {"const": "v1"},
    "context_package_id": {"type": "string", "minLength": 1},
    "analysis_case_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "document_snapshot_id": {"type": "string", "minLength": 1},
    "ingestion_batch_id": {"type": "string", "minLength": 1},
    "document_ingestion_result_event_id": {"type": "string", "minLength": 1},
    "document_profile_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "embedding_profile_ref": {"type": "string", "minLength": 1},
    "search_index_build_id": {"type": "string", "minLength": 1},
    "document_relation_build_id": {"type": "string", "minLength": 1},
    "ranking_policy_version": {"type": "string", "minLength": 1},
    "query_plan_version": {"type": "string", "minLength": 1},
    "retrieval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedding_profile_version_id",
        "embedding_profile_binding_key",
        "vector_top_k",
        "keyword_top_k",
        "final_top_k",
        "adjacent_distance"
      ],
      "properties": {
        "embedding_profile_version_id": {"type": "string", "minLength": 1},
        "embedding_profile_binding_key": {"type": "string", "minLength": 1},
        "vector_top_k": {"type": "integer", "minimum": 1, "maximum": 1000},
        "keyword_top_k": {"type": "integer", "minimum": 1, "maximum": 1000},
        "final_top_k": {"type": "integer", "minimum": 1, "maximum": 1000},
        "adjacent_distance": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "structured_change_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "business_summary": {"type": "string", "minLength": 1},
    "context_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "document_id", "compressed_summary", "relevance_reason", "evidence_refs"],
        "properties": {
          "section_id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "heading_path": {"type": "string"},
          "compressed_summary": {"type": "string", "minLength": 1},
          "relevance_reason": {"enum": ["direct_change", "rag_candidate", "parent", "adjacent", "related", "cross_document", "acceptance"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "retrieval_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "query_purpose", "retrieval_mode", "candidate_refs"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "query_purpose": {"enum": ["business_behavior", "precise_anchor", "acceptance_criteria"]},
          "retrieval_mode": {"const": "hybrid"},
          "candidate_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "token_budget": {"type": "integer", "minimum": 1},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
