{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/business-data-template.schema.json",
  "title": "BusinessDataTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "template_id",
    "template_key",
    "template_version",
    "project_id",
    "name_ja",
    "status",
    "parameters",
    "entities",
    "preconditions",
    "shared_variables",
    "data_sets",
    "generation_flow"
  ],
  "properties": {
    "artifact_type": {"const": "BusinessDataTemplate"},
    "schema_version": {"const": "v1"},
    "template_id": {"$ref": "#/$defs/nonBlank"},
    "template_key": {"$ref": "#/$defs/nonBlank"},
    "template_version": {"$ref": "#/$defs/nonBlank"},
    "project_id": {"$ref": "#/$defs/nonBlank"},
    "name_ja": {"$ref": "#/$defs/nonBlank"},
    "status": {"enum": ["draft", "approved", "retired"]},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "description_ja"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "required": {"type": "boolean"},
          "description_ja": {"$ref": "#/$defs/nonBlank"},
          "default": {}
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_ref", "role", "depends_on", "producer_step_id", "cleanup_step_id", "identifier_variables"],
        "properties": {
          "entity_ref": {"$ref": "#/$defs/nonBlank"},
          "role": {"enum": ["master", "detail"]},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
          "producer_step_id": {"$ref": "#/$defs/nonBlank"},
          "cleanup_step_id": {"$ref": "#/$defs/nonBlank"},
          "identifier_variables": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          }
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["precondition_id", "description_ja", "parameter", "operator"],
        "properties": {
          "precondition_id": {"$ref": "#/$defs/nonBlank"},
          "description_ja": {"$ref": "#/$defs/nonBlank"},
          "parameter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "operator": {"enum": ["exists", "non_blank", "equals", "one_of", "greater_than"]},
          "expected": {}
        }
      }
    },
    "shared_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variable", "producer_step_id", "consumer_step_ids"],
        "properties": {
          "variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "producer_step_id": {"$ref": "#/$defs/nonBlank"},
          "consumer_step_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}}
        }
      }
    },
    "data_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_data_id", "setup_actions", "cleanup_policy"],
        "properties": {
          "test_data_id": {"$ref": "#/$defs/nonBlank"},
          "setup_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "action_type", "target", "payload"],
              "properties": {
                "action_id": {"$ref": "#/$defs/nonBlank"},
                "action_type": {"enum": ["http", "sql", "fixture"]},
                "target": {"$ref": "#/$defs/nonBlank"},
                "payload": {"type": "object"}
              }
            }
          },
          "cleanup_policy": {"enum": ["isolated_environment", "delete_after_run", "retain"]}
        }
      }
    },
    "generation_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "title", "steps", "final_assertions", "cleanup_policy", "cleanup_steps"],
      "properties": {
        "flow_id": {"$ref": "#/$defs/nonBlank"},
        "title": {"$ref": "#/$defs/nonBlank"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/generationStep"}},
        "final_assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
        "cleanup_policy": {"enum": ["isolated_environment", "delete_after_run", "retain"]},
        "cleanup_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/generationStep"}}
      }
    }
  },
  "$defs": {
    "nonBlank": {"type": "string", "minLength": 1},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "observe_via", "subject", "operator", "expected"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/nonBlank"},
        "observe_via": {"enum": ["response", "api", "database", "ui", "fixture", "test"]},
        "subject": {"$ref": "#/$defs/nonBlank"},
        "operator": {"enum": ["equals", "contains", "count_equals", "exists", "satisfies"]},
        "expected": {}
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "source", "path", "required"],
      "properties": {
        "variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source": {"enum": ["response", "database", "ui", "fixture"]},
        "path": {"$ref": "#/$defs/nonBlank"},
        "required": {"type": "boolean"}
      }
    },
    "generationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "sequence", "channel", "business_action", "inputs", "depends_on", "output_bindings", "postconditions"],
      "properties": {
        "step_id": {"$ref": "#/$defs/nonBlank"},
        "sequence": {"type": "integer", "minimum": 1},
        "channel": {"enum": ["fixture", "http", "sql", "ui"]},
        "business_action": {"$ref": "#/$defs/nonBlank"},
        "entity_ref": {"$ref": "#/$defs/nonBlank"},
        "target": {"$ref": "#/$defs/nonBlank"},
        "screen_ref": {"$ref": "#/$defs/nonBlank"},
        "ui_action_ref": {"$ref": "#/$defs/nonBlank"},
        "inputs": {"type": "object"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
        "output_bindings": {"type": "array", "items": {"$ref": "#/$defs/outputBinding"}},
        "postconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
      },
      "allOf": [
        {
          "if": {"properties": {"channel": {"const": "ui"}}},
          "then": {"required": ["screen_ref", "ui_action_ref"]},
          "else": {"required": ["target"]}
        }
      ]
    }
  }
}
