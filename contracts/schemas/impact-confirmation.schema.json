{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/impact-confirmation.schema.json",
  "title": "ImpactConfirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "confirmation_id",
    "impact_report_id",
    "confirmed_by",
    "approved_item_ids",
    "rejected_item_ids",
    "confirmed_at"
  ],
  "properties": {
    "artifact_type": {"const": "ImpactConfirmation"},
    "schema_version": {"const": "v1"},
    "confirmation_id": {"type": "string", "minLength": 1},
    "impact_report_id": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": "string", "minLength": 1},
    "approved_item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "rejected_item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "user_note": {"type": "string"},
    "confirmed_at": {"type": "string", "format": "date-time"}
  }
}
