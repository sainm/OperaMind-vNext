{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/copilot-impact-context.schema.json",
  "title": "CopilotImpactContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "context_id",
    "coding_task_id",
    "project_id",
    "analysis_case_id",
    "source_document_snapshot_id",
    "target_document_snapshot_id",
    "search_index_build_id",
    "document_change_refs",
    "code_scope",
    "created_at"
  ],
  "properties": {
    "artifact_type": {"const": "CopilotImpactContext"},
    "schema_version": {"enum": ["v1", "v2"]},
    "context_id": {"type": "string", "minLength": 1},
    "coding_task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "analysis_case_id": {"type": "string", "minLength": 1},
    "source_document_snapshot_id": {"type": "string", "minLength": 1},
    "target_document_snapshot_id": {"type": "string", "minLength": 1},
    "search_index_build_id": {"type": "string", "minLength": 1},
    "document_change_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "code_scope": {
      "type": "array",
      "minItems": 1
    },
    "generated_by": {"type": "string", "minLength": 1},
    "generator_provider": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "code_scope_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_path", "target_symbols", "recommended_action", "test_file_refs", "rationale", "ui_impact"],
      "properties": {
        "target_path": {"type": "string", "minLength": 1},
        "target_symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "recommended_action": {"enum": ["modify", "add", "delete", "review_only"]},
        "test_file_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rationale": {"type": "string", "minLength": 1},
        "ui_impact": {"type": "boolean"}
      }
    },
    "code_scope_v2": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_path", "target_symbols", "recommended_action", "test_file_refs", "rationale", "ui_impact", "related_code_paths", "graph_path_refs"],
        "properties": {
          "target_path": {"type": "string", "minLength": 1},
          "target_symbols": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "recommended_action": {"enum": ["modify", "add", "delete", "review_only"]},
          "test_file_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string", "minLength": 1},
          "ui_impact": {"type": "boolean"},
          "related_code_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "graph_path_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "v1"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "code_scope": {"items": {"$ref": "#/$defs/code_scope_v1"}}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "v2"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "code_scope": {"items": {"$ref": "#/$defs/code_scope_v2"}}
        }
      }
    }
  ]
}
