{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/copilot-coding-task.schema.json",
  "title": "CopilotCodingTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "coding_task_id",
    "change_request_id",
    "project_id",
    "execution_mode",
    "provider_contract",
    "task_summary",
    "mcp_server_name",
    "required_mcp_tools",
    "created_by",
    "created_at"
  ],
  "properties": {
    "artifact_type": {"const": "CopilotCodingTask"},
    "schema_version": {"enum": ["v1", "v2"]},
    "coding_task_id": {"type": "string", "minLength": 1},
    "change_session_id": {"type": ["string", "null"], "minLength": 1},
    "change_request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "analysis_case_id": {"type": ["string", "null"], "minLength": 1},
    "repository_id": {"type": ["string", "null"], "minLength": 1},
    "edit_packet_id": {"type": ["string", "null"], "minLength": 1},
    "approval_grant_id": {"type": ["string", "null"], "minLength": 1},
    "base_repository_revision": {"type": ["string", "null"], "minLength": 1},
    "initial_stage": {
      "enum": [
        "document_change",
        "code_scope",
        "compile_test",
        "ui_test_revision"
      ]
    },
    "task_kind": {
      "enum": ["change_delivery", "change_execution", "ui_test_plan_revision"]
    },
    "execution_basis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["impact_report_id", "document_change_refs"],
      "properties": {
        "impact_report_id": {"type": "string", "minLength": 1},
        "document_change_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "plan_revision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "source_orchestration_id",
        "source_test_plan_id",
        "instruction",
        "confirmed_operations_json",
        "selections_json"
      ],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "source_orchestration_id": {"type": "string", "minLength": 1},
        "source_test_plan_id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 10000},
        "confirmed_operations_json": {"type": "string", "minLength": 2, "maxLength": 50000},
        "selections_json": {"type": "string", "minLength": 2, "maxLength": 20000},
        "locator_failure_evidence_json": {"type": "string", "minLength": 2, "maxLength": 50000}
      }
    },
    "retry_of_coding_task_id": {"type": "string", "minLength": 1},
    "attempt_number": {"type": "integer", "minimum": 1},
    "execution_mode": {"enum": ["copilot_coding_plan", "copilot_change_task"]},
    "provider_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "route", "provider_id"],
      "properties": {
        "interface": {"const": "coding_task_provider_v1"},
        "route": {"enum": ["local_bridge", "api_provider"]},
        "provider_id": {"type": "string", "minLength": 1}
      }
    },
    "task_summary": {"type": "string", "minLength": 1, "maxLength": 10000},
    "change_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_text",
        "source_document_ref",
        "target_document_ref",
        "business_rules",
        "ambiguity_status"
      ],
      "properties": {
        "requirement_text": {"type": ["string", "null"], "maxLength": 50000},
        "source_document_ref": {"type": ["string", "null"], "maxLength": 4000},
        "target_document_ref": {"type": ["string", "null"], "maxLength": 4000},
        "business_rules": {
          "type": "array",
          "maxItems": 200,
          "items": {"type": "object"}
        },
        "ambiguity_status": {"enum": ["clear", "needs_confirmation"]}
      }
    },
    "target_project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detection_status",
        "stack_id",
        "evidence",
        "missing_signals"
      ],
      "properties": {
        "detection_status": {"enum": ["supported", "unrecognized"]},
        "stack_id": {
          "type": ["string", "null"],
          "enum": ["springboot15-thymeleaf-gradle", null]
        },
        "framework": {"const": "Spring Boot 1.5"},
        "template_engine": {"const": "Thymeleaf"},
        "build_system": {"const": "Gradle Wrapper"},
        "source_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "change_constraints": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "compile_command": {
          "oneOf": [
            {"const": ["./gradlew", "classes", "testClasses", "--no-daemon"]},
            {"const": ["./gradlew.bat", "classes", "testClasses", "--no-daemon"]}
          ]
        },
        "test_command": {
          "oneOf": [
            {"const": ["./gradlew", "test", "--no-daemon"]},
            {"const": ["./gradlew.bat", "test", "--no-daemon"]}
          ]
        },
        "build_command": {
          "oneOf": [
            {"const": ["./gradlew", "build", "--no-daemon"]},
            {"const": ["./gradlew.bat", "build", "--no-daemon"]}
          ]
        },
        "coverage_command": {
          "oneOf": [
            {"const": ["./gradlew", "test", "jacocoTestReport", "--no-daemon"]},
            {"const": ["./gradlew.bat", "test", "jacocoTestReport", "--no-daemon"]}
          ]
        },
        "coverage_report": {
          "const": "build/reports/jacoco/test/jacocoTestReport.xml"
        },
        "quality_readiness": {"enum": ["ready", "blocked"]},
        "quality_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "quality_missing_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "missing_signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"detection_status": {"const": "supported"}},
            "required": ["detection_status"]
          },
          "then": {
            "required": [
              "framework",
              "template_engine",
              "build_system",
              "source_kinds",
              "change_constraints",
              "compile_command",
              "test_command",
              "build_command"
            ],
            "properties": {
              "stack_id": {"const": "springboot15-thymeleaf-gradle"},
              "missing_signals": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_order", "required_outputs"],
      "properties": {
        "stage_order": {
          "const": [
            "requirement",
            "document_change",
            "code_scope",
            "compile_test",
            "ui_validation",
            "final_report"
          ]
        },
        "required_outputs": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document_diff",
              "code_diff",
              "test_plan",
              "test_data_plan"
            ]
          }
        }
      }
    },
    "output_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_order", "tool", "test_planning_requires_validated_diff"],
      "properties": {
        "stage_order": {
          "const": ["document_change", "code_scope", "test_planning"]
        },
        "tool": {"const": "copilot_record_change_outputs"},
        "test_planning_requires_validated_diff": {"const": true}
      }
    },
    "mcp_server_name": {"const": "operaMind"},
    "required_mcp_tools": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "copilot_get_coding_task",
          "copilot_record_change_outputs",
          "copilot_run_task_command",
          "copilot_validate_task_diff",
          "copilot_record_task_result"
        ]
      }
    },
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "v1"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "change_session_id",
          "analysis_case_id",
          "repository_id",
          "edit_packet_id",
          "approval_grant_id",
          "base_repository_revision"
        ],
        "properties": {
          "execution_mode": {"const": "copilot_coding_plan"},
          "change_session_id": {"type": "string", "minLength": 1},
          "analysis_case_id": {"type": "string", "minLength": 1},
          "repository_id": {"type": "string", "minLength": 1},
          "edit_packet_id": {"type": "string", "minLength": 1},
          "approval_grant_id": {"type": "string", "minLength": 1},
          "base_repository_revision": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "v2"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": [
          "change_context",
          "workflow",
          "output_protocol",
          "initial_stage"
        ],
        "properties": {"execution_mode": {"const": "copilot_change_task"}}
      }
    },
    {
      "if": {
        "properties": {"task_kind": {"const": "change_execution"}},
        "required": ["task_kind"]
      },
      "then": {
        "required": [
          "change_session_id",
          "analysis_case_id",
          "repository_id",
          "edit_packet_id",
          "approval_grant_id",
          "base_repository_revision",
          "execution_basis"
        ],
        "properties": {
          "initial_stage": {"const": "compile_test"},
          "change_session_id": {"type": "string", "minLength": 1},
          "analysis_case_id": {"type": "string", "minLength": 1},
          "repository_id": {"type": "string", "minLength": 1},
          "edit_packet_id": {"type": "string", "minLength": 1},
          "approval_grant_id": {"type": "string", "minLength": 1},
          "base_repository_revision": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
