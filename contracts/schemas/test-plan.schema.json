{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/test-plan.schema.json",
  "title": "TestPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "test_plan_id", "change_request_id", "project_id", "status", "test_cases"],
  "properties": {
    "artifact_type": {"const": "TestPlan"},
    "schema_version": {"const": "v1"},
    "test_plan_id": {"type": "string", "minLength": 1},
    "change_request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_case_id", "title", "level", "execution_mode", "business_rule_refs", "acceptance_criteria_refs", "preconditions", "steps", "expected_results", "test_data_refs"],
        "properties": {
          "test_case_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "level": {"enum": ["source", "api", "ui"]},
          "execution_mode": {"enum": ["deterministic", "browser"]},
          "business_rule_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "acceptance_criteria_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "steps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "expected_results": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "test_data_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
