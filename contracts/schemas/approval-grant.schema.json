{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/approval-grant.schema.json",
  "title": "ApprovalGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "approval_grant_id",
    "change_session_id",
    "analysis_case_id",
    "edit_packet_id",
    "impact_report_id",
    "confirmation_id",
    "project_id",
    "repository_id",
    "base_repository_revision",
    "editable_files",
    "read_only_files",
    "test_files",
    "allowed_actions",
    "command_profile_version_id",
    "allowed_test_command_refs",
    "allowed_ui_scenarios",
    "forbidden_globs",
    "approved_by",
    "expires_at",
    "out_of_scope_policy"
  ],
  "properties": {
    "artifact_type": {"const": "ApprovalGrant"},
    "schema_version": {"const": "v1"},
    "approval_grant_id": {"type": "string", "minLength": 1},
    "change_session_id": {"type": "string", "minLength": 1},
    "analysis_case_id": {"type": "string", "minLength": 1},
    "edit_packet_id": {"type": "string", "minLength": 1},
    "impact_report_id": {"type": "string", "minLength": 1},
    "confirmation_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": "string", "minLength": 1},
    "base_repository_revision": {"type": "string", "minLength": 1},
    "editable_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "read_only_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "test_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_actions": {
      "type": "array",
      "items": {"enum": ["read", "modify", "add_test", "run_test", "record_result", "execute_ui", "record_evidence"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "command_profile_version_id": {"type": "string", "minLength": 1},
    "allowed_test_command_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
      "uniqueItems": true
    },
    "allowed_ui_scenarios": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_globs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "approved_by": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "out_of_scope_policy": {"const": "collect_and_request_once"}
  }
}
