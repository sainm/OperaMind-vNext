{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/change-orchestration-plan.schema.json",
  "title": "ChangeOrchestrationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "orchestration_id",
    "change_request_id",
    "project_id",
    "analysis_case_id",
    "status",
    "structured_change_refs",
    "impact_report_id",
    "reviewed_case_id",
    "reviewed_case_digest",
    "repository_revision",
    "code_scope",
    "artifact_refs",
    "ui_scenarios",
    "blocking_reasons"
  ],
  "properties": {
    "artifact_type": {"const": "ChangeOrchestrationPlan"},
    "schema_version": {"const": "v1"},
    "orchestration_id": {"type": "string", "minLength": 1},
    "change_request_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "analysis_case_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "structured_change_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "impact_report_id": {"type": "string", "minLength": 1},
    "reviewed_case_id": {"type": "string", "minLength": 1},
    "reviewed_case_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_revision": {"type": "string", "minLength": 1},
    "code_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["impact_item_id", "target_path", "target_symbols", "recommended_action", "test_file_refs"],
        "properties": {
          "impact_item_id": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "minLength": 1},
          "target_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "recommended_action": {"enum": ["modify", "add", "delete", "review_only", "no_change"]},
          "test_file_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_criteria_id", "test_plan_id", "test_data_plan_id", "coverage_report_id"],
      "properties": {
        "acceptance_criteria_id": {"type": "string", "minLength": 1},
        "test_plan_id": {"type": "string", "minLength": 1},
        "test_data_plan_id": {"type": "string", "minLength": 1},
        "coverage_report_id": {"type": "string", "minLength": 1}
      }
    },
    "ui_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "title", "test_data_refs", "steps", "expected_results"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "test_data_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected_results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "blocking_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"blocking_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"properties": {"blocking_reasons": {"minItems": 1}}}
    }
  ]
}
