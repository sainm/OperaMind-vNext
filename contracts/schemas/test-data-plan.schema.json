{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/contracts/test-data-plan.schema.json",
  "title": "TestDataPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "test_data_plan_id",
    "test_plan_id",
    "project_id",
    "status",
    "data_sets",
    "generation_flows",
    "blocking_reasons"
  ],
  "properties": {
    "artifact_type": {"const": "TestDataPlan"},
    "schema_version": {"enum": ["v1", "v2"]},
    "test_data_plan_id": {"type": "string", "minLength": 1},
    "test_plan_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "data_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_data_id", "test_case_refs", "setup_actions", "cleanup_policy"],
        "properties": {
          "test_data_id": {"type": "string", "minLength": 1},
          "test_case_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "setup_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "action_type", "target", "payload"],
              "properties": {
                "action_id": {"type": "string", "minLength": 1},
                "action_type": {"enum": ["http", "sql", "fixture"]},
                "target": {"type": "string", "minLength": 1},
                "payload": {"type": "object"}
              }
            }
          },
          "cleanup_policy": {"enum": ["isolated_environment", "delete_after_run", "retain"]}
        }
      }
    },
    "generation_flows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/generationFlow"}
    },
    "blocking_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"blocking_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"properties": {"blocking_reasons": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "v2"}},
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "generation_flows": {
            "items": {
              "properties": {
                "steps": {
                  "items": {
                    "if": {
                      "properties": {"channel": {"const": "ui"}},
                      "required": ["channel"]
                    },
                    "then": {"required": ["playwright"]}
                  }
                },
                "cleanup_steps": {
                  "items": {
                    "if": {
                      "properties": {"channel": {"const": "ui"}},
                      "required": ["channel"]
                    },
                    "then": {"required": ["playwright"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlank": {"type": "string", "minLength": 1},
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "observe_via", "subject", "operator", "expected"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/nonBlank"},
        "observe_via": {"enum": ["response", "api", "database", "ui", "fixture", "test"]},
        "subject": {"$ref": "#/$defs/nonBlank"},
        "operator": {"enum": ["equals", "contains", "count_equals", "exists", "satisfies"]},
        "expected": {}
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "source", "path", "required"],
      "properties": {
        "variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source": {"enum": ["response", "database", "ui", "fixture"]},
        "path": {"$ref": "#/$defs/nonBlank"},
        "required": {"type": "boolean"}
      }
    },
    "playwrightLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "value"],
      "properties": {
        "by": {"enum": ["role", "label", "placeholder", "text", "alt_text", "title", "test_id", "css"]},
        "value": {"$ref": "#/$defs/nonBlank"},
        "name": {"$ref": "#/$defs/nonBlank"},
        "exact": {"type": "boolean"},
        "frame": {"$ref": "#/$defs/nonBlank"}
      }
    },
    "playwrightObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind"],
      "properties": {
        "key": {"$ref": "#/$defs/nonBlank"},
        "kind": {"enum": ["url", "title", "text", "count", "visible", "enabled", "checked", "value", "attribute"]},
        "locator": {"$ref": "#/$defs/playwrightLocator"},
        "attribute_name": {"$ref": "#/$defs/nonBlank"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["text", "count", "visible", "enabled", "checked", "value", "attribute"]}}},
          "then": {"required": ["locator"]}
        },
        {
          "if": {"properties": {"kind": {"const": "attribute"}}},
          "then": {"required": ["attribute_name"]}
        }
      ]
    },
    "playwrightPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0}
      }
    },
    "playwrightAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "observations", "mask_locators"],
      "properties": {
        "action": {"enum": ["goto", "reload", "go_back", "go_forward", "click", "double_click", "fill", "type", "clear", "select_option", "check", "uncheck", "press", "hover", "focus", "blur", "scroll_into_view", "drag_to", "wait_for", "wait_for_url", "wait_for_load_state"]},
        "path": {"type": "string", "pattern": "^/(?!/).*"},
        "locator": {"$ref": "#/$defs/playwrightLocator"},
        "target_locator": {"$ref": "#/$defs/playwrightLocator"},
        "value": {},
        "key": {"$ref": "#/$defs/nonBlank"},
        "state": {"enum": ["attached", "detached", "visible", "hidden", "load", "domcontentloaded", "networkidle"]},
        "mouse_button": {"enum": ["left", "right", "middle"]},
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["Alt", "Control", "Meta", "Shift"]}
        },
        "position": {"$ref": "#/$defs/playwrightPosition"},
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/playwrightObservation"}
        },
        "mask_locators": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/playwrightLocator"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"enum": ["goto", "wait_for_url"]}}},
          "then": {"required": ["path"]}
        },
        {
          "if": {"properties": {"action": {"enum": ["click", "double_click", "fill", "type", "clear", "select_option", "check", "uncheck", "press", "hover", "focus", "blur", "scroll_into_view", "drag_to", "wait_for"]}}},
          "then": {"required": ["locator"]}
        },
        {
          "if": {"properties": {"action": {"enum": ["fill", "type", "select_option"]}}},
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"action": {"const": "press"}}},
          "then": {"required": ["key"]}
        },
        {
          "if": {"properties": {"action": {"const": "drag_to"}}},
          "then": {"required": ["target_locator"]}
        },
        {
          "if": {"properties": {"action": {"const": "wait_for"}}},
          "then": {"required": ["state"], "properties": {"state": {"enum": ["attached", "detached", "visible", "hidden"]}}}
        },
        {
          "if": {"properties": {"action": {"const": "wait_for_load_state"}}},
          "then": {"required": ["state"], "properties": {"state": {"enum": ["load", "domcontentloaded", "networkidle"]}}}
        }
      ]
    },
    "computerUseFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "objective", "max_actions", "requires_confirmation", "observations"],
      "properties": {
        "reason": {"enum": ["non_dom_control", "canvas", "native_dialog", "virtualized_ui", "locator_unavailable", "playwright_capability_gap"]},
        "objective": {"type": "string", "minLength": 2, "maxLength": 2000},
        "max_actions": {"type": "integer", "minimum": 1, "maximum": 20},
        "requires_confirmation": {"const": true},
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/playwrightObservation"}
        }
      }
    },
    "generationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "sequence",
        "channel",
        "business_action",
        "inputs",
        "depends_on",
        "output_bindings",
        "postconditions"
      ],
      "properties": {
        "step_id": {"$ref": "#/$defs/nonBlank"},
        "sequence": {"type": "integer", "minimum": 1},
        "channel": {"enum": ["fixture", "http", "sql", "ui"]},
        "business_action": {"$ref": "#/$defs/nonBlank"},
        "data_effect": {"enum": ["none", "creates", "updates", "deletes"]},
        "test_step_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        },
        "entity_ref": {"$ref": "#/$defs/nonBlank"},
        "target": {"$ref": "#/$defs/nonBlank"},
        "screen_ref": {"$ref": "#/$defs/nonBlank"},
        "ui_action_ref": {"$ref": "#/$defs/nonBlank"},
        "playwright": {"$ref": "#/$defs/playwrightAction"},
        "computer_use_fallback": {"$ref": "#/$defs/computerUseFallback"},
        "inputs": {"type": "object"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        },
        "output_bindings": {
          "type": "array",
          "items": {"$ref": "#/$defs/outputBinding"}
        },
        "postconditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/assertion"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"channel": {"const": "ui"}}},
          "then": {"required": ["screen_ref", "ui_action_ref"]},
          "else": {"required": ["target"]}
        }
      ]
    },
    "generationFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "title",
        "test_data_refs",
        "test_case_refs",
        "steps",
        "final_assertions",
        "cleanup_policy",
        "cleanup_steps"
      ],
      "properties": {
        "flow_id": {"$ref": "#/$defs/nonBlank"},
        "title": {"$ref": "#/$defs/nonBlank"},
        "test_data_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        },
        "test_case_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/generationStep"}
        },
        "final_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/assertion"}
        },
        "cleanup_policy": {"enum": ["isolated_environment", "delete_after_run", "retain"]},
        "cleanup_steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/generationStep"}
        }
      }
    }
  }
}
