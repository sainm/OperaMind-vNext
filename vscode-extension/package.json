{
  "name": "operamind-copilot-bridge",
  "displayName": "OperaMind Copilot Bridge",
  "description": "Deliver bounded OperaMind change tasks to VS Code GitHub Copilot.",
  "version": "0.4.0",
  "publisher": "operamind-local",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/sainm/OperaMind-vNext.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Only local diagnostics run while untrusted; OperaMind coding task operations remain disabled."
    }
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:vsix": "npm test && node --check extension.js && node --check bridgeClient.js && node --check dashboardModel.js && node --check diagnostics.js && node --check runtimeManifest.js && node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && vsce package --allow-missing-repository --out dist/operamind-copilot-bridge.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  },
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "operamind.local",
        "label": "OperaMind Local"
      }
    ],
    "commands": [
      {
        "command": "operamind.checkForTasks",
        "title": "OperaMind: 変更タスクを確認"
      },
      {
        "command": "operamind.confirmCurrentCheckpoint",
        "title": "OperaMind: 現在の工程を確認"
      },
      {
        "command": "operamind.rejectCurrentCheckpoint",
        "title": "OperaMind: 現在の工程を差戻し"
      },
      {
        "command": "operamind.configureBridgeToken",
        "title": "OperaMind: Bridge Token を復旧設定"
      },
      {
        "command": "operamind.resumeCurrentTask",
        "title": "OperaMind: 現在のタスクを再開"
      },
      {
        "command": "operamind.cancelCurrentTask",
        "title": "OperaMind: 現在のタスクを取消"
      },
      {
        "command": "operamind.diagnoseLocalEnvironment",
        "title": "OperaMind: ローカル環境を診断"
      },
      {
        "command": "operamind.openCurrentTask",
        "title": "OperaMind: 確認して Copilot を開く",
        "icon": "$(play)"
      },
      {
        "command": "operamind.refreshDashboard",
        "title": "OperaMind: 最新状態に更新",
        "icon": "$(refresh)"
      },
      {
        "command": "operamind.openWeb",
        "title": "OperaMind: Web を開く",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "operamind",
          "title": "OperaMind",
          "icon": "media/operamind.svg"
        }
      ]
    },
    "views": {
      "operamind": [
        {
          "id": "operamind.controlPanel",
          "name": "コントロール"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "operamind.refreshDashboard",
          "when": "view == operamind.controlPanel",
          "group": "navigation"
        },
        {
          "command": "operamind.openWeb",
          "when": "view == operamind.controlPanel",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "OperaMind Copilot Bridge",
      "properties": {
        "operamind.bridge.url": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Loopback-only OperaMind Web URL."
        },
        "operamind.bridge.pollSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 120,
          "description": "Seconds between local Bridge task checks."
        },
        "operamind.bridge.acceptedBy": {
          "type": "string",
          "default": "vscode-user",
          "description": "Audit label recorded when you confirm a task in VS Code."
        }
      }
    }
  }
}
