{
  "profile_type": "CommandExecutionProfile",
  "profile_id": "gradle-project-example",
  "profile_version": "1.0.0",
  "templates": [
    {
      "command_ref": "targeted-unit",
      "argv": ["./gradlew", "test", "--no-daemon"],
      "working_directory": ".",
