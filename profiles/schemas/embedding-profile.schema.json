{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operamind.dev/profiles/embedding-profile.schema.json",
  "title": "EmbeddingProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_type",
    "profile_id",
    "profile_version",
    "provider",
    "base_url_env",
    "api_key_env",
    "model_env",
    "expected_dimensions",
    "batch_size",
    "timeout_seconds",
    "max_retries",
    "preprocessing_version",
    "ranking_policy_version"
  ],
  "properties": {
    "profile_type": {"const": "EmbeddingProfile"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "provider": {"enum": ["openai_compatible"]},
    "base_url_env": {"$ref": "#/$defs/environment_variable"},
    "api_key_env": {"$ref": "#/$defs/environment_variable"},
    "model_env": {"$ref": "#/$defs/environment_variable"},
    "expected_dimensions": {"type": "integer", "minimum": 1, "maximum": 16000},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 2048},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
    "preprocessing_version": {"type": "string", "minLength": 1},
    "ranking_policy_version": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "environment_variable": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    }
  }
}
